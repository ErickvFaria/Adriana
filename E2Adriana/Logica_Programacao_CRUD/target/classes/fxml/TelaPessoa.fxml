<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="400.0" prefWidth="600.0"
            stylesheets="@../css/TelaDeOpcao.css"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="CRUD.controller.TelaPessoaController">

    <children>
        <Text layoutX="190.0" layoutY="117.0" strokeType="OUTSIDE" strokeWidth="0.0"
              text="Selecione uma Opção: " AnchorPane.leftAnchor="190.0" AnchorPane.rightAnchor="158.2177734375">
            <font>
                <Font size="25.0"/>
            </font>
        </Text>

        <Button fx:id="btn_cadastrar_pessoas" alignment="CENTER" contentDisplay="CENTER"
                layoutX="249.0" layoutY="190.0" mnemonicParsing="false"
                onAction="#cadastrarPessoas" prefHeight="38.0" prefWidth="158.0" text="Cadastrar Pessoas"
                AnchorPane.leftAnchor="247.0" AnchorPane.rightAnchor="195.0">
            <cursor>
                <Cursor fx:constant="HAND"/>
            </cursor>
        </Button>

        <Button fx:id="btn_listar_pessoas" alignment="CENTER" contentDisplay="CENTER"
                layoutX="249.0" layoutY="250.0" mnemonicParsing="false"
                onAction="#listarPessoas" prefHeight="38.0" prefWidth="158.0" text="Listar Pessoas"
                AnchorPane.leftAnchor="247.0" AnchorPane.rightAnchor="195.0">
            <cursor>
                <Cursor fx:constant="HAND"/>
            </cursor>
        </Button>

        <ImageView fitHeight="94.0" fitWidth="108.0"
                   layoutX="86.0" layoutY="190.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../images/pessoas-juntas.png"/>
            </image>
        </ImageView>

        <Button fx:id="btn_voltar" alignment="CENTER" contentDisplay="CENTER"
                layoutX="29.0" layoutY="26.0" mnemonicParsing="false"
                onAction="#VoltarTelaInicial" prefHeight="36.0" prefWidth="138.0" text="Voltar">
            <cursor>
                <Cursor fx:constant="HAND"/>
            </cursor>
        </Button>
    </children>
</AnchorPane>
