<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="Apane_telaInicial" minHeight="300.0" minWidth="300.0" prefHeight="600.0" prefWidth="800.0" stylesheets="@../css/TelaInicial.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CRUD.controller.TelaInicialController">

    <children>
        <!-- StackPane centralizador -->
        <StackPane prefHeight="600" prefWidth="800" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- Grupo com todos os elementos originais -->
            <Group>
                <!-- Logo -->
                <ImageView fx:id="img_inicial" fitHeight="150.0" fitWidth="200.0" layoutX="338.0" layoutY="76.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/estudos.jpg" />
                    </image>
                </ImageView>

                <HBox layoutX="314.0" layoutY="353.0" prefHeight="59.0" prefWidth="200.0" spacing="10.0">
                    <children>
                        <Button fx:id="btn_bicicleta" mnemonicParsing="false" onAction="#selecionarBicicleta" prefHeight="50.0" prefWidth="50.0">
                            <graphic>
                                <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/bicicleta.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btn_parque" mnemonicParsing="false" onAction="#selecionarParque" prefHeight="50.0" prefWidth="50.0">
                            <graphic>
                                <ImageView fx:id="btn_" fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/parque-infantil.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                        <Button fx:id="btn_pessoas" mnemonicParsing="false" onAction="#SelecionarPessoas" prefHeight="58.0" prefWidth="122.0">
                            <graphic>
                                <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/pessoas-juntas.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                </HBox>
            <Label alignment="CENTER" layoutX="291.0" layoutY="261.0" prefHeight="43.0" prefWidth="283.0" text="Escolha uma Opção:" textAlignment="CENTER">
               <font>
                  <Font name="Nirmala UI Semilight" size="24.0" />
               </font>
            </Label>
            </Group>
        </StackPane>
    </children>
</AnchorPane>
