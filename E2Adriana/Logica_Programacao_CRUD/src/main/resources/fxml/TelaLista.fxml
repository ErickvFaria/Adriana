<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@../css/TelaLista.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CRUD.controller.TelaListaController">

    <top>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>

            <!-- Linha 1: Título centralizado com fundo branco e borda arredondada -->
            <HBox alignment="CENTER" styleClass="title-box">
                <Label styleClass="label-title" text="Visualizar Lista " />
            </HBox>

            <!-- Linha 2: Filtros e pesquisa -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <TextField fx:id="TextFieldNomePesquisa" prefWidth="300.0" promptText="Pesquisar por nome" styleClass="search-field" />
                <Button fx:id="btnBuscar" onAction="#buscarInformacao" styleClass="button-primary" text="Buscar" />
            <Button fx:id="btnVoltar" onAction="#voltar" styleClass="button-primary" text="Voltar" />
            </HBox>
        </VBox>
    </top>

    <!-- Área de cards -->
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" vbarPolicy="AS_NEEDED">
            <content>
                <FlowPane fx:id="cardsBox" alignment="CENTER" hgap="20" vgap="20">
                    <padding>
                        <Insets bottom="20" left="20" right="20" top="20" />
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
