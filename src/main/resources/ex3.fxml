<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<TabPane prefHeight="400.0" prefWidth="600.0" tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LinguagemProgramacao.controllers.AtributosController">

    <tabs>
        <!-- Tab Artista -->
        <Tab text="Artista">
            <content>
                <AnchorPane>
                    <children>
                        <TextField fx:id="txtNomeArtista" layoutX="220" layoutY="128" />
                        <Label layoutX="139.0" layoutY="133.0" text="Nome" />

                        <TextField fx:id="txtIdadeArtista" layoutX="220" layoutY="185" />
                        <Label layoutX="140.0" layoutY="190.0" text="Idade" />

                        <TextField fx:id="txtTipoArte" layoutX="220" layoutY="243" />
                        <Label layoutX="138.0" layoutY="248.0" text="Tipo de Arte" />

                        <Button fx:id="btnSalvarArtista" layoutX="268" layoutY="296" text="Salvar" />
                  <Label layoutX="220.0" layoutY="25.0" prefHeight="45.0" prefWidth="147.0" text="Artista">
                     <font>
                        <Font name="Academy Engraved LET Plain:1.0" size="47.0" />
                     </font>
                  </Label>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <!-- Tab Arte -->
        <Tab text="Arte">
            <content>
                <AnchorPane>
                    <children>
                        <TextField fx:id="txtIdArte" layoutX="220" layoutY="172" />
                        <Label layoutX="126.0" layoutY="177.0" text="Identificador" />

                        <TextField fx:id="txtAnoCriacao" layoutX="221" layoutY="124" />
                        <Label layoutX="128.0" layoutY="129.0" text="Ano criação" />

                        <TextField fx:id="txtPreco" layoutX="220" layoutY="221" />
                        <Label layoutX="132.0" layoutY="226.0" text="Preço(R$)" />

                        <Button fx:id="btnSalvarArte" layoutX="269" layoutY="268" text="Salvar" />
                  <Label layoutX="226.0" layoutY="24.0" prefHeight="45.0" prefWidth="147.0" text="Arte">
                     <font>
                        <Font name="Academy Engraved LET Plain:1.0" size="47.0" />
                     </font>
                  </Label>
                    </children>
                </AnchorPane>
            </content>
        </Tab>

        <!-- Tab Lixo -->
        <Tab text="Lixo">
            <content>
                <AnchorPane>
                    <children>
                        <TextField fx:id="txtPeso" layoutX="198" layoutY="126" />
                        <Label layoutX="97.0" layoutY="131.0" text="Peso(KG)" />

                        <TextField fx:id="txtQuantidade" layoutX="198" layoutY="171" />
                        <Label layoutX="97.0" layoutY="176.0" text="Quantidade(UND)" />

                        <TextField fx:id="txtCheiro" layoutX="198" layoutY="221" />
                        <Label layoutX="97.0" layoutY="226.0" text="Cheiro(0-10))" />

                        <Button fx:id="btnSalvarLixo" layoutX="246" layoutY="264" text="Salvar" textFill="#1c1e1c" />
                  <Label layoutX="204.0" layoutY="39.0" prefHeight="45.0" prefWidth="147.0" text="Lixo">
                     <font>
                        <Font name="Academy Engraved LET Plain:1.0" size="47.0" />
                     </font>
                  </Label>
                    </children>
                </AnchorPane>
            </content>
        </Tab>
    </tabs>
</TabPane>
